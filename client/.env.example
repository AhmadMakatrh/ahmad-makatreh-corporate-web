# Backend API Base URL
# For local development with ASP.NET Core: http://localhost:5000 or https://localhost:7001
# For production Cloudflare Pages: set to your deployed ASP.NET Core API domain (e.g. https://api.ahmad-makatreh.vip)
VITE_API_BASE_URL=http://localhost:5000

# Optional Cloudflare Turnstile Site Key (Public)
# Leave blank for development/bypass mode
VITE_TURNSTILE_SITE_KEY=
