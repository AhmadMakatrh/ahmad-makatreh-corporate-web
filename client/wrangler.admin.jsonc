        "migrations_dir": "../server/cloudflare/migrations"
      }
    ],
    "ratelimits": [
      { "name": "ADMIN_RATE_LIMITER", "namespace_id": "10122061", "simple": { "limit": 120, "period": 60 } },
      { "name": "ADMIN_REPLY_RATE_LIMITER", "namespace_id": "10122062", "simple": { "limit": 6, "period": 60 } },
      { "name": "ADMIN_UPLOAD_RATE_LIMITER", "namespace_id": "10122063", "simple": { "limit": 6, "period": 60 } },
      { "name": "ADMIN_LOGIN_RATE_LIMITER", "namespace_id": "10122064", "simple": { "limit": 5, "period": 60 } }
    ]
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist-admin",
    "not_found_handling": "single-page-application"
  }
