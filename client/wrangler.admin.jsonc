{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ahmad-makatreh-admin",
  "main": "workers/admin-worker.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "preview_urls": true,
  "vars": {
    "ADMIN_ORIGIN": "https://admin.ahmad-makatreh.vip",
    "SUPABASE_URL": "https://kghmejpjvbmcivnlnkgf.supabase.co",
    "SUPABASE_STORAGE_BUCKET": "ahmad-makatreh-media",
    "MEDIA_PROVIDER": "supabase"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ahmad-makatreh",
      "database_id": "c1653642-1587-474e-8160-aa45ffdee878",
      "migrations_dir": "../server/cloudflare/migrations"
    }
  ],
  "ratelimits": [
    { "name": "ADMIN_RATE_LIMITER", "namespace_id": "10122051", "simple": { "limit": 120, "period": 60 } },
    { "name": "ADMIN_REPLY_RATE_LIMITER", "namespace_id": "10122052", "simple": { "limit": 6, "period": 60 } },
    { "name": "ADMIN_UPLOAD_RATE_LIMITER", "namespace_id": "10122053", "simple": { "limit": 6, "period": 60 } },
    { "name": "ADMIN_LOGIN_RATE_LIMITER", "namespace_id": "10122054", "simple": { "limit": 5, "period": 60 } }
  ],
  "previews": {
    "vars": {
      "ADMIN_ORIGIN": "https://auth-gate-v2-ahmad-makatreh-admin.ahmadthemakatrh.workers.dev",
      "SUPABASE_URL": "https://kghmejpjvbmcivnlnkgf.supabase.co",
