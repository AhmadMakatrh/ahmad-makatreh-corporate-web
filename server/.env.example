# codeguard:components:start
# Source: server/.env.example
# Declarations and references retain their native language names and order.
# codeguard:components:end
# Reference for host/container environment settings; ASP.NET does not load this file automatically.
# Replace placeholders privately in the hosting secret manager. Do not commit a real .env file.
ASPNETCORE_ENVIRONMENT=Production
Persistence__Provider=Postgres
Persistence__AutoMigrateInDevelopment=false
ConnectionStrings__DefaultConnection=Host=YOUR-DB-HOST;Port=5432;Database=YOUR-DB;Username=YOUR-DB-USER;Password=SET-IN-SECRET-MANAGER;SSL Mode=VerifyFull
BookingAbuse__HmacKey=SET-A-RANDOM-SECRET-OF-AT-LEAST-32-UTF8-BYTES

AdminAccess__TeamDomain=https://YOUR-TEAM.cloudflareaccess.com
AdminAccess__Audience=YOUR-ACCESS-APPLICATION-AUD
AdminAccess__AllowedEmails__0=YOUR-ADMIN-EMAIL
AdminAccess__Origin=https://admin.ahmad-makatreh.vip

Media__Provider=R2
Media__AccountId=YOUR-CLOUDFLARE-ACCOUNT-ID
Media__Bucket=YOUR-PUBLIC-SITE-MEDIA-BUCKET
Media__AccessKeyId=SET-IN-SECRET-MANAGER
Media__SecretAccessKey=SET-IN-SECRET-MANAGER
Media__PublicBaseUrl=https://YOUR-PUBLIC-MEDIA-DOMAIN

Email__Enabled=true
Email__SmtpHost=YOUR-SMTP-HOST
Email__SmtpPort=587
Email__EnableSsl=true
Email__Username=SET-IN-SECRET-MANAGER
Email__Password=SET-IN-SECRET-MANAGER
Email__FromEmail=YOUR-VERIFIED-SENDER-EMAIL
Email__RecipientEmail=YOUR-INBOX-EMAIL

Turnstile__Enabled=true
Turnstile__AllowDevelopmentBypass=false
Turnstile__SecretKey=SET-IN-SECRET-MANAGER
# Enable proxy trust only for a network setup that validates its trusted proxy.
ReverseProxy__TrustCloudflareProxy=false
